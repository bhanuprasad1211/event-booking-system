*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/
pyenv/

# Django local database (SQLite)
*.sqlite3
db.sqlite3

# Django media & static collection
media/
/static_collected/
staticfiles/

# Logs and backups
*.log
*.bak

# Testing & coverage
.coverage
htmlcov/
.pytest_cache/
.tox/

